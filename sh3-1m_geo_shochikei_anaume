
<h2 class="sr-only">地形 重要語句 全範囲穴埋め練習 — 左列問題・右列語群</h2>
<style>
*{box-sizing:border-box;margin:0;padding:0}
.app{padding:.75rem 0;font-family:var(--font-sans)}
.topbar{display:flex;align-items:center;gap:8px;margin-bottom:.85rem;flex-wrap:wrap}
.pw{flex:1;min-width:60px;height:4px;background:var(--color-background-secondary);border-radius:2px}
.pf{height:100%;border-radius:2px;background:#1D9E75;transition:width .35s}
.stxt{font-size:12px;color:var(--color-text-secondary);white-space:nowrap}
.bp{padding:6px 14px;font-size:12px;cursor:pointer;border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);background:var(--color-background-primary);color:var(--color-text-primary);transition:background .12s}
.bp:hover{background:var(--color-background-secondary)}
.bg{padding:6px 12px;font-size:12px;cursor:pointer;border:0.5px solid var(--color-border-tertiary);border-radius:var(--border-radius-md);background:transparent;color:var(--color-text-secondary);transition:background .12s}
.bg:hover{background:var(--color-background-secondary)}
.res{font-size:12px;color:var(--color-text-secondary)}
.res.ok{color:#3B6D11;font-weight:500}
.res.ng{color:#A32D2D}
.cols{display:grid;grid-template-columns:1fr 220px;height:580px;border:0.5px solid var(--color-border-tertiary);border-radius:var(--border-radius-lg);overflow:hidden}
.lc{overflow-y:auto;padding:12px 14px;border-right:0.5px solid var(--color-border-tertiary)}
.rc{overflow-y:auto;padding:10px;background:var(--color-background-secondary);display:flex;flex-direction:column;gap:0}
.bl{font-size:11.5px;font-weight:500;color:var(--color-text-secondary);margin-bottom:8px;padding-bottom:6px;border-bottom:0.5px solid var(--color-border-tertiary)}
.bk{display:flex;flex-wrap:wrap;gap:5px}
.chip{display:inline-block;padding:4px 7px;background:var(--color-background-primary);border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);font-size:11.5px;cursor:grab;user-select:none;transition:all .12s;color:var(--color-text-primary);white-space:nowrap}
.chip:hover{border-color:var(--color-border-primary)}
.chip.dragging{opacity:.25}
.chip.sel{background:rgba(55,138,221,.13);border-color:#378ADD;color:#185FA5;font-weight:500}
.sh{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:500;color:var(--color-text-secondary);margin:12px 0 5px;padding-bottom:4px;border-bottom:0.5px solid var(--color-border-tertiary)}
.sh:first-child{margin-top:0}
.sd{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.qr{font-size:13px;line-height:2.1;color:var(--color-text-primary)}
.qn{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:10px;font-weight:500;background:var(--color-background-secondary);color:var(--color-text-secondary);vertical-align:middle;margin-right:4px;flex-shrink:0}
.blank{display:inline-flex;align-items:center;justify-content:center;min-width:90px;min-height:23px;padding:2px 8px;border-radius:4px;border:1.5px dashed var(--color-border-secondary);vertical-align:middle;transition:all .12s;font-size:12px;font-weight:500;color:transparent;cursor:default}
.blank.tgt{border-style:solid;border-color:#378ADD;background:rgba(55,138,221,.09)}
.blank.over{border-style:solid;background:rgba(29,158,117,.1);border-color:#1D9E75}
.blank.filled{border-style:solid;border-color:var(--color-border-secondary);background:var(--color-background-primary);color:var(--color-text-primary);cursor:pointer}
.blank.filled:hover{border-color:var(--color-border-primary)}
.blank.ok{border-style:solid;background:rgba(99,153,34,.13);border-color:#639922;color:#3B6D11;cursor:default}
.blank.ng{border-style:solid;background:rgba(226,75,74,.1);border-color:#E24B4A;color:#A32D2D;cursor:pointer}
</style>

<div class="app">
  <div class="topbar">
    <div class="pw"><div class="pf" id="pgf" style="width:0%"></div></div>
    <div class="stxt" id="sc">0 / 50</div>
    <button class="bp" onclick="checkAll()">答え合わせ</button>
    <button class="bg" onclick="resetAll()">全リセット</button>
    <span class="res" id="res"></span>
  </div>
  <div class="cols">
    <div class="lc" id="lcol"></div>
    <div class="rc">
      <div class="bl">語群 — <span id="rem">50</span>語残り</div>
      <div class="bk" id="bk"></div>
    </div>
  </div>
</div>

<script>
const S=[
  {title:'河川流域の小地形',color:'#185FA5',qs:[
    {t:'太陽エネルギーは {X} の源で、岩石の風化や土砂の侵食・運搬・堆積を引き起こす。',a:'外的営力'},
    {t:'比較的小規模な谷や沖積平野などは {X} とよばれる。',a:'小地形'},
    {t:'山地の急斜面が崩れて後退し、{X} が形成される。',a:'V字谷'},
    {t:'谷口では礫や砂が扇形に堆積し、{X} が形成される。',a:'扇状地'},
    {t:'扇状地を流れる川は砂礫層を伏流し、{X} になることが多い。',a:'水無川'},
    {t:'洪水時に砂が堆積してできる微高地を {X} とよぶ。',a:'自然堤防'},
    {t:'自然堤防の背後にできる水はけの悪い低地を {X} とよぶ。',a:'後背湿地'},
    {t:'流路変更後に残される三日月形の湖を {X} とよぶ。',a:'三日月湖（河跡湖）'},
    {t:'洪水によって形成される地形全体を {X} とよぶ。',a:'泥濫原'},
    {t:'河口で砂や泥が堆積してできる地形を {X}（デルタ）とよぶ。',a:'三角州'},
  ]},
  {title:'台地・丘陵・河岸段丘',color:'#3B6D11',qs:[
    {t:'沖積平野の周縁部にある崖に囲まれた平坦な地形を {X} とよぶ。',a:'台地'},
    {t:'平坦地を含まず起伏に富む低い山地を {X} とよぶ。',a:'丘陵'},
    {t:'河川沿いに形成される階段状の地形を {X} とよぶ。',a:'河岸段丘'},
    {t:'階段状地形のほぼ平坦な面を {X} とよぶ。',a:'段丘面'},
    {t:'段丘面を区切る崖を {X} とよぶ。',a:'段丘崖'},
    {t:'縄文時代の海面上昇を {X} とよぶ。',a:'縄文海進'},
    {t:'海面上昇によって水没した谷を {X} とよぶ。',a:'おぼれ谷'},
  ]},
  {title:'海岸にみられる小地形',color:'#0F6E56',qs:[
    {t:'砂の堆積作用が活発な海岸を {X} とよぶ。',a:'砂浜海岸'},
    {t:'岩盤への侵食作用が活発な海岸を {X} とよぶ。',a:'岩石海岸'},
    {t:'干潮時に露出する泥や砂の地形を {X} とよぶ。',a:'干潟'},
    {t:'砂州が延びて陸と島をつなぐ地形を {X}（トンボロ）とよぶ。',a:'陸繋砂州'},
    {t:'砂州によって外海と隔てられた浅い水域を {X} とよぶ。',a:'ラグーン'},
    {t:'土地の隆起や海面低下で形成される海岸を {X} とよぶ。',a:'離水海岸'},
    {t:'土地の沈降や海面上昇で形成される海岸を {X} とよぶ。',a:'沈水海岸'},
    {t:'入り江が連続する沈水海岸を {X} とよぶ。',a:'リアス海岸'},
    {t:'氷河のU字谷に海水が入り込んだ地形を {X} とよぶ。',a:'フィヨルド'},
    {t:'河口付近の低地に海水が入り込んだ地形を {X}（三角江）とよぶ。',a:'エスチュアリ'},
  ]},
  {title:'サンゴ礁の発達',color:'#D85A30',qs:[
    {t:'島を縁どるように発達するサンゴ礁を {X} とよぶ。',a:'裾礁'},
    {t:'ラグーンを挟んで島を取り巻くサンゴ礁を {X} とよぶ。',a:'堡礁'},
    {t:'島が沈降した後に輪状に残ったサンゴ礁を {X} とよぶ。',a:'環礁'},
  ]},
  {title:'氷河によってつくられた地形',color:'#534AB7',qs:[
    {t:'谷の地形制約を受けて流れる氷河を {X} とよぶ。',a:'山岳氷河'},
    {t:'地形の制約なしに巨大なドーム状をなす氷河を {X}（氷床）とよぶ。',a:'大陸氷河'},
    {t:'氷河が谷底や谷壁を深くえぐってできた谷を {X} とよぶ。',a:'U字谷'},
    {t:'山頂近くに形成されるすり鉢状のくぼ地を {X}（圏谷）とよぶ。',a:'カール'},
    {t:'氷河末端部に堤防状に堆積した丘を {X} とよぶ。',a:'モレーン'},
    {t:'氷河地形の凹地に水がたまった湖を {X} とよぶ。',a:'氷河湖'},
    {t:'地球全体が寒冷だった時代を {X} とよぶ。',a:'氷期'},
  ]},
  {title:'乾燥地域にみられる地形',color:'#BA7517',qs:[
    {t:'砂丘が発達する砂漠を {X} とよぶ。',a:'砂砂漠'},
    {t:'岩石が露出した砂漠を {X} とよぶ。',a:'岩石砂漠'},
    {t:'硬い岩石が侵食されてできたテーブル状の地形を {X} とよぶ。',a:'メサ'},
    {t:'メサがさらに侵食された塔状の地形を {X} とよぶ。',a:'ビュート'},
    {t:'湿潤地域から乾燥地域へ流れ込む川を {X} とよぶ。',a:'外来河川'},
    {t:'乾燥地域で水が得られる場所を {X} とよぶ。',a:'オアシス'},
    {t:'乾燥地域のふだんは流水のないかれ川を {X} とよぶ。',a:'ワジ'},
    {t:'海に出口をもたない川を {X} とよぶ。',a:'内陸河川'},
  ]},
  {title:'カルスト地形',color:'#444441',qs:[
    {t:'石灰岩地域の地表にできる多数のくぼ地を {X} とよぶ。',a:'ドリーネ'},
    {t:'ドリーネが結合・拡大した地形を {X} とよぶ。',a:'ウバーレ'},
    {t:'100km²以上に及ぶ大きな溶食盆地を {X} とよぶ。',a:'ポリエ（溶食盆地）'},
    {t:'地下水による溶食でできた地下空洞を {X} とよぶ。',a:'鍾乳洞'},
    {t:'石灰岩の溶食によって形成される特有の地形を {X} 地形とよぶ。',a:'カルスト'},
  ]},
];

const TOTAL=S.reduce((a,s)=>a+s.qs.length,0);
const ALL_W=S.flatMap(s=>s.qs.map(q=>q.a));
for(let i=ALL_W.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ALL_W[i],ALL_W[j]]=[ALL_W[j],ALL_W[i]];}

let fills={},chkd=new Set(),selW=null,dragW=null;
function K(si,qi){return si+'_'+qi;}
function usedSet(){return new Set(Object.values(fills));}
function cntOk(){let c=0;S.forEach((s,si)=>s.qs.forEach((q,qi)=>{if(fills[K(si,qi)]===q.a)c++;}));return c;}

function render(){
  const c=cntOk();
  document.getElementById('pgf').style.width=Math.round(c/TOTAL*100)+'%';
  document.getElementById('sc').textContent=c+' / '+TOTAL;
  const used=usedSet();
  const avail=ALL_W.filter(w=>!used.has(w));
  document.getElementById('rem').textContent=avail.length;
  document.getElementById('bk').innerHTML=avail.map(w=>{
    const sel=selW===w;
    return '<div class="chip'+(sel?' sel':'')+'" draggable="true" data-w="'+encW(w)+'" ondragstart="dsS(event)" ondragend="dsE(event)" onclick="cClk(event)">'+w+'</div>';
  }).join('');
  let n=0;
  document.getElementById('lcol').innerHTML=S.map((s,si)=>{
    const allOk=S[si].qs.every((q,qi)=>fills[K(si,qi)]===q.a);
    let h='<div class="sh"><span class="sd" style="background:'+s.color+'"></span>'+s.title+(allOk?' ✓':'')+'</div>';
    s.qs.forEach((q,qi)=>{
      n++;
      const key=K(si,qi),w=fills[key],ic=chkd.has(key),io=w===q.a;
      let bc='blank';
      if(w){bc+=ic?(io?' ok':' ng'):' filled';}
      else if(selW){bc+=' tgt';}
      const[p1,p2]=q.t.split('{X}');
      h+='<div class="qr"><span class="qn">'+n+'</span>'+p1+'<span class="'+bc+'" data-key="'+key+'" ondragover="bOv(event)" ondragleave="bLv(event)" ondrop="bDr(event)" onclick="bClk(event)">'+(w||'')+'</span>'+p2+'</div>';
    });
    return h;
  }).join('');
}

function encW(w){return w.replace(/"/g,'&quot;');}
function bOv(ev){ev.preventDefault();ev.currentTarget.classList.add('over');}
function bLv(ev){ev.currentTarget.classList.remove('over');}
function dsS(ev){dragW=ev.currentTarget.dataset.w;ev.dataTransfer.setData('text/plain',dragW);ev.dataTransfer.effectAllowed='copy';setTimeout(()=>{ev.target.classList.add('dragging');},0);}
function dsE(ev){dragW=null;document.querySelectorAll('.chip.dragging').forEach(e=>e.classList.remove('dragging'));}
function cClk(ev){const w=ev.currentTarget.dataset.w;selW=selW===w?null:w;render();}
function bDr(ev){ev.preventDefault();ev.currentTarget.classList.remove('over');const w=ev.dataTransfer.getData('text/plain')||dragW;if(w)place(w,ev.currentTarget.dataset.key);}
function bClk(ev){
  const key=ev.currentTarget.dataset.key;
  if(selW){place(selW,key);return;}
  const[si,qi]=key.split('_').map(Number);
  const io=fills[key]===S[si].qs[qi].a;
  if(fills[key]&&(!chkd.has(key)||!io)){delete fills[key];chkd.delete(key);render();}
}
function place(w,key){
  const[si,qi]=key.split('_').map(Number);
  if(chkd.has(key)&&fills[key]===S[si].qs[qi].a)return;
  Object.keys(fills).forEach(ek=>{if(fills[ek]===w){delete fills[ek];chkd.delete(ek);}});
  if(fills[key])chkd.delete(key);
  fills[key]=w;chkd.delete(key);selW=null;render();
}
function checkAll(){
  S.forEach((s,si)=>s.qs.forEach((q,qi)=>{const k=K(si,qi);if(fills[k])chkd.add(k);}));
  const c=cntOk(),tot=Object.keys(fills).length;
  const res=document.getElementById('res');
  if(!tot){res.textContent='語句を配置してください';res.className='res';}
  else if(c===TOTAL){res.textContent='全問正解！ 🎉';res.className='res ok';}
  else{res.textContent=c+'/'+TOTAL+' 正解';res.className='res ng';}
  render();
}
function resetAll(){fills={};chkd.clear();selW=null;const r=document.getElementById('res');r.textContent='';r.className='res';render();}
render();
</script>
